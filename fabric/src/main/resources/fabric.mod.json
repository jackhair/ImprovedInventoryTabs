{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${description}",
  "authors": [
    "KQP",
    "LiamMCW",
    "Andrew6rant (Andrew Grant)",
    "Jack Hair"
  ],
  "contact": {
    "homepage": "https://github.com/jackhair/InventoryTabs",
    "sources": "https://github.com/jackhair/InventoryTabs",
    "issues": "https://github.com/jackhair/InventoryTabs/issues"
  },
  "license": "${license}",
  "icon": "assets/inventorytabs/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.kqp.inventorytabs.init.InventoryTabsFabric"
    ],
    "client": [
      "com.kqp.inventorytabs.init.InventoryTabsClientFabric"
    ],
    "modmenu": [
      "com.kqp.inventorytabs.init.InventoryTabsModMenu"
    ]
  },
  "mixins": [
    "inventorytabs.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "minecraft": ">=${minecraft_version}",
    "java": ">=${java_version}",
    "cloth-config": "*"
  },
  "custom": {
    "modmenu": [
      "com.kqp.inventorytabs.init.InventoryTabsConfig"
    ]
  },
  "suggests": {
    "biginv": "*",
    "playerex": "*",
    "modmenu": "*"
  }
}
